<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The foreground is opaque: the silver and
  black halves run to every edge and the grid, dot and wordmark sit inside the
  66 dp safe zone, so any launcher mask (circle/squircle) crops only the two
  halves, never the mark — matching the iOS AppIcon. Generated by Scripts/icons/make-icons.py.
  Pre-API-26 launchers fall back to the square ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- No <monochrome>: the foreground is a full opaque composite, which a themed-
         icon launcher would render as a solid tinted square. Omitting it keeps the
         normal colored icon on all launchers. -->
</adaptive-icon>
