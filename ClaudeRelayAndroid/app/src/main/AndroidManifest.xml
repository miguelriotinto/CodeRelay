<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network connectivity callbacks: the AndroidConnectivitySource registers a
         NetworkCallback so the coordinator can trigger recovery when the network
         comes back (the NWPathMonitor analog). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QR scanner (Task 9): runtime CAMERA permission; camera is optional so the
         app installs on cameraless devices (the scanner is just unavailable). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Haptic feedback on QR-scan detection (QrScannerScreen.vibrate). Normal
         (non-dangerous) permission, no runtime request needed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="relay.app.RelayApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaudeRelayM1">

        <activity
            android:name="relay.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClaudeRelayM1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- clauderelay://session/<uuid> deep links (Task 9). Matches the iOS
                 URL scheme so a QR scanned on iOS opens the Android app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clauderelay" />
            </intent-filter>
        </activity>
    </application>

</manifest>
