<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Background = brand black; foreground = the
  "CR" mark (ClaudeRelayApp icon-1024). The mark sits within the inner ~61% safe
  zone and its margins are the same black as the background, so any launcher mask
  (circle/squircle) crops only black, never the CR — matching the iOS AppIcon.
  Pre-API-26 launchers fall back to the square ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- No <monochrome>: the foreground is a full opaque composite, which a themed-
         icon launcher would render as a solid tinted square. Omitting it keeps the
         normal colored CR mark on all launchers. -->
</adaptive-icon>
