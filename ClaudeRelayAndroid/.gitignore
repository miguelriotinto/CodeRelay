# Release signing secrets — NEVER commit. The release buildType reads the upload
# key from keystore.properties (storeFile/storePassword/keyAlias/keyPassword) and
# falls back to debug signing when this file is absent (headless/CI builds). See
# RELEASE.md for the keytool + keystore.properties setup a human runs locally.
keystore.properties
*.keystore
*.jks

# iCloud/macOS sync duplicates (e.g. "gradlew 2", "Foo 2.kt") — never commit; they
# also break the D8 dex step ("defined multiple times"). Delete on sight.
* [0-9]
* [0-9].*
