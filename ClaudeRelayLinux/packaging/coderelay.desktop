[Desktop Entry]
Type=Application
Name=Code[Relay]
GenericName=Remote Terminal Relay
Comment=Attach to coding-agent terminal sessions on a remote machine
Exec=coderelay %u
Icon=coderelay
Terminal=false
Categories=Development;
Keywords=terminal;relay;claude;agent;ssh;

# Hyprland (and every other WM) matches rules against this class.
#
# This is the class the window ACTUALLY reports, measured with `hyprctl clients`
# on BOTH `./gradlew :app:run` and the packaged jpackage launcher — not the
# package name. Compose Desktop's skiko backend derives the class from the Kotlin
# main class and ignores `awt.appClassName` (tried in main(), as a Gradle jvmArg,
# and as -D on a raw `java -cp` launch; no effect in any of them).
#
# The class is pinned by `@file:JvmName("CodeRelay")` in Main.kt, so it does not
# change if that file is renamed. Guessing "coderelay" here would make every
# user-written window rule silently fail to match.
StartupWMClass=relay-app-CodeRelay
StartupNotify=true

# Registers the clauderelay:// scheme so `clauderelay://session/<uuid>` deep
# links and pairing URLs from `claude-relay setup` open in the app. The shared
# DeepLinks parser handles both forms.
MimeType=x-scheme-handler/clauderelay;

Actions=NewSession;

[Desktop Action NewSession]
Name=New Session
Exec=coderelay --new-session
